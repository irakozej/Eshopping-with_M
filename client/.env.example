# ── Store identity & settings ────────────────────────────────────────────
# Vite only exposes vars prefixed with VITE_ to the browser. These mirror the
# server's APP_NAME / WHATSAPP_NUMBER / DELIVERY_FREE_THRESHOLD_RWF so the
# frontend can read them instead of hardcoding. See client/src/lib/config.js.
VITE_APP_NAME=Beyond Beauty Boutique
VITE_WHATSAPP_NUMBER=+250794803462
VITE_DELIVERY_FREE_THRESHOLD_RWF=50000

# Card payments toggle (mirror of server PAYMENTS_STRIPE_ENABLED).
# When false, the checkout hides the card option and shows only MTN MoMo.
VITE_PAYMENTS_STRIPE_ENABLED=false

# ── Stripe (card payments) ───────────────────────────────────────────────
# Get keys at https://dashboard.stripe.com/test/apikeys
# The PUBLISHABLE key is safe to expose in the browser bundle.
# Pair this with STRIPE_SECRET_KEY (sk_test_...) on the server.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# ── Sentry (error tracking) ──────────────────────────────────────────────
# Get DSN at https://sentry.io → project settings → Client Keys (DSN)
VITE_SENTRY_DSN_FRONTEND=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Plausible (privacy-friendly analytics) ───────────────────────────────
# Register your domain at https://plausible.io → add a site
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js

# Set to "true" to log analytics calls to the browser console (useful in dev)
VITE_ANALYTICS_DEBUG=false
