# ── Stripe (card payments) ───────────────────────────────────────────────
# Get keys at https://dashboard.stripe.com/test/apikeys
# The PUBLISHABLE key is safe to expose in the browser bundle.
# Pair this with STRIPE_SECRET_KEY (sk_test_...) on the server.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# ── Sentry (error tracking) ──────────────────────────────────────────────
# Get DSN at https://sentry.io → project settings → Client Keys (DSN)
VITE_SENTRY_DSN_FRONTEND=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Plausible (privacy-friendly analytics) ───────────────────────────────
# Register your domain at https://plausible.io → add a site
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js

# Set to "true" to log analytics calls to the browser console (useful in dev)
VITE_ANALYTICS_DEBUG=false
