PORT=5000
# Session signing secret. REQUIRED to be strong in production (the server
# refuses to boot otherwise). Generate with: openssl rand -hex 32
JWT_SECRET=change_me_in_production
# Set to "true" only when running behind a reverse proxy (nginx, Render,
# Railway...) so rate limiting sees the real client IP.
TRUST_PROXY=false
STRIPE_SECRET_KEY=sk_test_your_stripe_key
CLIENT_URL=http://localhost:5174

# ── Store identity & contact ─────────────────────────────────────────────
APP_NAME=Beyond Beauty Boutique
SUPPORT_EMAIL=beautybeyond706@gmail.com
WHATSAPP_NUMBER=+250794803462

# ── Delivery ─────────────────────────────────────────────────────────────
# Orders at/above this RWF subtotal ship free in Kigali.
DELIVERY_FREE_THRESHOLD_RWF=50000
# Default delivery estimate, in days.
DELIVERY_DEFAULT_DAYS=1

# ── Payments: feature flags ──────────────────────────────────────────────
# Toggle payment providers without touching code. Card (Stripe) is OFF at
# launch; the Stripe backend route stays intact but is gated behind this flag.
PAYMENTS_STRIPE_ENABLED=false
PAYMENTS_MOMO_ENABLED=true

# ── SMTP — real email delivery ───────────────────────────────────────────
# Leave SMTP_HOST blank in development to fall back to console logging
# (no real emails are sent). Fill in for staging/production.
#
# Gmail setup (free, recommended for low-volume MVP):
#   1. Enable 2-Step Verification on your Google account:
#      https://myaccount.google.com/security
#   2. Generate an App Password (NOT your normal Gmail password):
#      https://myaccount.google.com/apppasswords
#      → App: "Mail", Device: "Other (M·Shop server)"
#      → Google gives you a 16-character code like "abcd efgh ijkl mnop"
#   3. Paste it into SMTP_PASS below (with or without spaces — both work).
#
# Notes:
#   - Use port 587 + SMTP_SECURE=false for STARTTLS (recommended).
#   - SMTP_FROM should match SMTP_USER for Gmail; otherwise messages
#     may be rewritten to "via gmail.com" or rejected.
#   - Free Gmail accounts: ~500 sends/day limit. For higher volume use
#     SendGrid, Postmark, or Amazon SES (same env vars, different host).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=beautybeyond706@gmail.com
SMTP_PASS=            # Gmail App Password, to follow
# Sender shown to recipients. Display name is the legal entity (Beyond Beauty
# LTD); address should match SMTP_USER for Gmail. If SMTP_FROM is blank, the
# code falls back to EMAIL_FROM_NAME + SMTP_USER.
SMTP_FROM=Beyond Beauty LTD <beautybeyond706@gmail.com>
EMAIL_FROM_NAME=Beyond Beauty LTD

# ── MTN Mobile Money (Collections API) ───────────────────────────────────
# Leave these blank to disable MoMo — checkout falls back to "demo mode"
# (order is created, no real charge). Fill in to enable real payments.
#
# SANDBOX setup (free, no real money):
#   1. Sign up at https://momodeveloper.mtn.com → subscribe to the
#      "Collection" product → copy your "Primary Key" (the Subscription Key).
#   2. Sandbox also needs an API User + API Key, which are created via API,
#      not the portal. Run our helper to generate them automatically:
#        npm run momo:provision -- <your-subscription-key>
#      It prints the three values below — paste them in, then:
#        npm run test:momo
#
# PRODUCTION (MTN Rwanda): MOMO_BASE_URL=https://proxy.momoapi.mtn.com
#   MOMO_TARGET_ENVIRONMENT=mtnrwanda  |  MOMO_CURRENCY=RWF
#   (API User/Key are issued by MTN, not self-provisioned.)
# Client-confirmed merchant short code (known). API User + API Key still to follow.
MOMO_MERCHANT_CODE=030002
MOMO_API_USER=        # to follow  (the API User UUID; server reads it as MOMO_API_USER_ID below)
MOMO_API_KEY=         # to follow

MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_SUBSCRIPTION_KEY=
# MOMO_API_USER_ID is the operational name the server util currently reads;
# set it to the same value as MOMO_API_USER above.
MOMO_API_USER_ID=
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_CURRENCY=EUR

# ── Sentry (error tracking) ──────────────────────────────────────────────
# Get DSN at https://sentry.io → project settings → Client Keys (DSN)
SENTRY_DSN_BACKEND=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
